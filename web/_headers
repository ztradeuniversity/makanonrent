# MakanOnRent — production security headers (Cloudflare Pages).
# Applies to every static asset served from web/. Function responses
# (functions/api/*) set their own headers via functions/utils/cors.js and
# are unaffected by this file.
#
# CSP is tuned against the ACTUAL codebase, verified before writing this:
#   - script-src has no 'unsafe-inline': zero inline <script> blocks exist
#     anywhere in web/ (confirmed by grep before this file was written).
#   - style-src keeps 'unsafe-inline': admin.html, location-manager.html
#     and submit.html use inline style="" attributes already — removing
#     them would be a redesign, not a security fix, so the exception is
#     kept narrowly on style-src only (not script-src, where it matters).
#   - img-src allows https: because property photos are served from
#     R2_PUBLIC_BASE_URL, an operator-configured domain not known here.
#   - media-src is stated explicitly and mirrors img-src. Without it the
#     directive falls back to default-src 'self', which silently blocks
#     the <video> the gallery renders from a presigned R2 URL
#     (functions/api/properties/media.js) — that URL is on the bucket's
#     S3 endpoint, never same-origin. Photos survived the omission only
#     because img-src happened to be listed.
#   - connect-src allows https: because uploads.js PUTs directly to a
#     presigned R2/S3 URL (functions/utils/r2.js), which is cross-origin
#     by design and would otherwise be blocked.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self' https:; font-src 'self'; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# The service worker must never be served from a stale cache: the browser
# revalidates it on every navigation, and a cached copy is exactly how a
# site ends up pinned to retired code it can no longer replace. The
# Service-Worker-Allowed header lets /sw.js claim the whole origin.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# Served with the right type so the browser parses it as a manifest;
# short-lived so an icon or name change is picked up the same day.
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# Icons are content-stable and referenced by fixed names.
/assets/img/*
  Cache-Control: public, max-age=604800
