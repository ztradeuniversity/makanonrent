# MakanOnRent — required environment variables (names only, no values).
# Copy to .env for local `wrangler pages dev` and set the same names as
# encrypted secrets in the Cloudflare Pages dashboard for production.
# NEVER commit a file with real values — .env is git-ignored on purpose.

# Supabase (server-side only — see functions/utils/supabase.js)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for functions/ inserts (bypasses RLS). NOT currently present in
# this project's local .env — must be added before the submit API works.
# Get it from Supabase → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (server-side only — see functions/utils/r2.js)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=makanonrent-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL for uploaded media (no trailing slash). The production
# custom domain is already attached to the bucket.
R2_PUBLIC_BASE_URL=https://images.makanonrent.com

# Used to restrict CORS on the API and to build absolute links. Notify Me
# emails use this to build the "view this property" link, so it must be the
# real public origin in production or the email arrives without a link.
SITE_URL=https://makanonrent.com

# Email delivery (server-side only — see functions/utils/mailer.js).
# RESEND_API_KEY   : Resend API key.
# EMAIL_FROM       : verified sender, e.g. "MakanOnRent <alerts@makanonrent.com>".
# EMAIL_WORKER_TOKEN: shared secret guarding POST /api/admin/email-worker,
#                     which drains the email queue. Any long random string.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_WORKER_TOKEN=
