# MakanOnRent — required environment variables (names only, no values).
# Copy to .env for local `wrangler pages dev` and set the same names as
# encrypted secrets in the Cloudflare Pages dashboard for production.
# NEVER commit a file with real values — .env is git-ignored on purpose.

# Supabase (server-side only — see functions/utils/supabase.js)
SUPABASE_URL=
# Required for OWNER sign-in (functions/utils/owner-auth.js): every
# Supabase Auth /auth/v1 call must carry it. This is the publishable key —
# it grants nothing on its own and RLS still applies. It is used
# server-side only; no key of any kind is served to the browser.
SUPABASE_ANON_KEY=
# Required for functions/ inserts (bypasses RLS). NOT currently present in
# this project's local .env — must be added before the submit API works.
# Get it from Supabase → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (server-side only — see functions/utils/r2.js)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=makanonrent-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL for uploaded media (no trailing slash). The production
# custom domain is already attached to the bucket.
R2_PUBLIC_BASE_URL=https://images.makanonrent.com

# Used to restrict CORS on the API and to build absolute links. Notify Me
# emails use this to build the "view this property" link, so it must be the
# real public origin in production or the email arrives without a link.
SITE_URL=https://makanonrent.com

# First-CEO bootstrap (server-side only — see functions/api/admin/bootstrap.js).
# migrations/0004 deliberately seeds NO admin account, and the console has
# no self-registration, so without this there is no way to create the first
# identity. POST /api/admin/bootstrap with this value in the
# X-Bootstrap-Token header creates one CEO and then refuses forever
# (it also refuses once any CEO row exists).
#
# Set it to a long random string, create the CEO, then UNSET it — leaving
# it configured serves no purpose once the guard has tripped.
ADMIN_BOOTSTRAP_TOKEN=

# Email delivery (server-side only — see functions/utils/mailer.js).
# RESEND_API_KEY   : Resend API key.
# EMAIL_FROM       : verified sender, e.g. "MakanOnRent <alerts@makanonrent.com>".
# EMAIL_WORKER_TOKEN: shared secret guarding POST /api/admin/email-worker,
#                     which drains the email queue. Any long random string.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_WORKER_TOKEN=

# Web Push / VAPID (server-side — see functions/utils/push.js).
# Generate ONE P-256 keypair and reuse it for the life of the deployment:
# rotating it invalidates every existing browser subscription silently.
#
#   npx web-push generate-vapid-keys
#
# VAPID_PUBLIC_KEY  : base64url, 65-byte uncompressed P-256 point. This one
#                     is PUBLIC — it is served to browsers by
#                     GET /api/push/key and is embedded in every
#                     subscription. Safe to expose; it must be exposed.
# VAPID_PRIVATE_KEY : base64url, 32 bytes. SECRET. Never served, never
#                     logged, never imported from web/. Anyone holding it
#                     can push notifications to every MakanOnRent
#                     subscriber.
# VAPID_SUBJECT     : contact URI for the push services, "mailto:you@..."
#                     or an https URL. Required by RFC 8292.
#
# Leaving these unset disables push cleanly: /api/push/key returns 503, the
# consent prompt is never shown, and publication still sends Notify Me
# emails exactly as before.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@makanonrent.com
